# OpenAI-compatible LLM endpoint used by the reporting module.
# Do not commit real API keys.
DEEPBREATH_LLM_API_KEY=
DEEPBREATH_LLM_BASE_URL=
DEEPBREATH_LLM_MODEL=

# FastAPI inference service configuration.
DEEPBREATH_MODEL_PATH=models/melspectogramTrained.h5
DEEPBREATH_MAX_UPLOAD_BYTES=26214400
DEEPBREATH_MAX_AUDIO_DURATION_SECONDS=60
DEEPBREATH_API_HOST=0.0.0.0
DEEPBREATH_API_PORT=8000
DEEPBREATH_LOG_LEVEL=info
